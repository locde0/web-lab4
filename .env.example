# Copy this file to .env and fill in real values:
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# Never commit the .env file: it is listed in .gitignore.

# --- Django core -------------------------------------------------------------
# Generate a new key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
# True only for local development.
DJANGO_DEBUG=True
# Comma-separated list of hosts the server may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS ----------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ------------------------------------------------------------------
# SQLite is used by default (DB_NAME is a file in the project root).
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Required only for a server database, e.g. PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=skycompute
# DB_USER=skycompute
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# --- JWT -----------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Logging -------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
